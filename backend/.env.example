# Defaults run locally with SQLite and private files, without external services.
ENVIRONMENT=local
AUTH_MODE=local
JWT_SECRET=local-development-only-change-before-deployment-32chars
# Set a generated Fernet key before storing real credentials. Never commit .env.
ENCRYPTION_KEY=
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OAUTH_REDIRECT_URLS=["http://localhost:3000/auth/callback","http://127.0.0.1:3000/auth/callback"]
WORKER_BACKEND=database
REDIS_URL=redis://localhost:6379/0
ALLOW_EXTERNAL_SUBMISSIONS=false
WEBHOOK_CONNECTOR_URL=
WEBHOOK_CONNECTOR_SECRET=
CONNECTOR_ALLOWED_HOSTS=[]
BROWSER_CONNECTOR_CONFIG={}
BROWSER_TIMEOUT_SECONDS=30
BROWSER_CHANNEL=chromium
# Docker build only: true installs Chromium and Linux system dependencies.
INSTALL_BROWSER=false
MAIL_MODE=demo
AUTH_EMAIL_MODE=capture
# Supabase can be local (CLI/Docker) or hosted. Backend validates provider-issued JWTs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=resumes
STORAGE_BACKEND=local
# Optional auth email SMTP; credentials are server-only.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Docker Compose only. Use a generated URL-safe value (letters/digits) of at least 32 characters.
POSTGRES_PASSWORD=
