{
  "manifest_version": 3,
  "name": "CyberApply — Save and scan a job",
  "version": "0.1.0",
  "description": "Save the visible job you choose and scan it against your private CyberApply CV.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://cyberapply-internal.covenda-1182.chatgpt.site/*"],
  "action": {"default_popup": "popup.html", "default_title": "Save or scan this job"},
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
